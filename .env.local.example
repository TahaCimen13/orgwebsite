# ─────────────────────────────────────────────────────────────
#  Bu dosyayı .env.local olarak kopyalayın ve değerleri doldurun.
#  .env.local git'e GÖNDERİLMEZ (.gitignore içinde).
# ─────────────────────────────────────────────────────────────

# Supabase > Project Settings > Data API > Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Supabase > Project Settings > API Keys > anon / public
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase > Project Settings > API Keys > service_role  (GİZLİ!)
# Bu anahtar RLS'i atlar. Tarayıcıya asla gönderilmez, yalnızca
# sunucuda kullanılır. Kimseyle paylaşmayın, git'e koymayın.
SUPABASE_SERVICE_ROLE_KEY=

# Admin paneline giriş şifresi — kendiniz belirleyin, uzun olsun
ADMIN_PASSWORD=

# Oturum çerezini imzalamak için rastgele bir dize.
# Üretmek için:  openssl rand -base64 32
ADMIN_SESSION_SECRET=
